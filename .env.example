# Copier ce fichier en .env (lu par Next.js et par les scripts), puis remplir les valeurs.
# Ne jamais commiter .env ou .env.local.

# --- Public (exposé au navigateur) ---
NEXT_PUBLIC_SUPABASE_URL=https://prpcafqjcedrrluglqpl.supabase.co
# Project Settings > API Keys > Publishable key (commence par sb_publishable_, ~46 caractères)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Serveur uniquement (jamais NEXT_PUBLIC_) ---
# Clé secrète Supabase (Project Settings > API Keys > Secret keys), commence par sb_secret_
SUPABASE_SECRET_KEY=

# --- Migrations et outillage (poste de développement uniquement, jamais sur Vercel) ---
SUPABASE_PROJECT_REF=prpcafqjcedrrluglqpl
SUPABASE_DB_PASSWORD=
# Jeton personnel Supabase (Account > Access Tokens), pour la CLI (db push, génération des types)
SUPABASE_ACCESS_TOKEN=
# Hôte du pooler Supabase en mode session (Dashboard > Connect > Session pooler).
# Les scripts construisent eux-mêmes l'URL de connexion :
#   postgresql://postgres.<ref>:<mot de passe encodé>@<hôte>:5432/postgres
# La connexion directe db.<ref>.supabase.co passe par IPv6 et échoue souvent : on ne l'utilise pas.
SUPABASE_POOLER_HOST=aws-0-eu-west-2.pooler.supabase.com
